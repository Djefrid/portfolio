# ============================================================
# MODÈLE DE CONFIGURATION — .env.local.example
# Copier ce fichier en .env.local et remplir avec vos valeurs
# NE JAMAIS commiter .env.local (déjà dans .gitignore)
# ============================================================

# ── Firebase ─────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ── Admins autorisés ─────────────────────────────────────────
# Admin principal — affiché dans le portfolio + connexion admin
NEXT_PUBLIC_ADMIN_EMAIL=ton@email.com
# Admin secondaire — optionnel, accès identique à l'admin principal
NEXT_PUBLIC_ADMIN_EMAIL_2=

# ── Email public du portfolio ─────────────────────────────────
# Affiché dans la section Contact et le JSON-LD SEO
NEXT_PUBLIC_CONTACT_EMAIL=ton@email.com

# ── SEO ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://votre-domaine.com

# ── Resend (formulaire de contact) ───────────────────────────
# Clé API Resend — côté serveur uniquement (sans NEXT_PUBLIC_)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Email qui recevra les messages du formulaire de contact
CONTACT_EMAIL=ton@email.com

# ── Firebase App Check — reCAPTCHA v3 ────────────────────────
# Clé publique (site key) — obtenir sur google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ── DeepL (traduction automatique FR↔EN) ─────────────────────
DEEPL_API_KEY=
